# ============================================================
# ZEROID BROADCAST BRIDGE — contoh file environment
# Cara pakai: salin file ini jadi .env lalu isi nilainya.
#   cp .env.example .env   (Windows: copy .env.example .env)
# JANGAN commit file .env ke git / share ke luar tim operator.
# ============================================================

# URL WebSocket plugin obs-websocket di OBS Studio.
# Biarkan localhost — OBS tidak boleh di-expose ke internet.
OBS_WS_URL=ws://127.0.0.1:4455

# Password WebSocket Server OBS Studio (Tools > WebSocket Server Settings).
# WAJIB kuat (bukan kosong). Tidak pernah dicatat ke log bridge.
OBS_PASSWORD=

# Host untuk server bridge. Default 127.0.0.1 (localhost SAJA — paling aman).
# JANGAN diganti 0.0.0.0 kecuali benar-benar paham risikonya.
BRIDGE_HOST=127.0.0.1

# Port server bridge untuk koneksi website.
BRIDGE_PORT=8078

# Token autentikasi website -> bridge. WAJIB diisi token kuat acak.
# Contoh generate (jalankan di terminal):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BRIDGE_TOKEN=

# Hint / catatan internal untuk operator (boleh diisi bebas).
BRIDGE_PASSWORD_HINT=Token hanya dibagikan ke website/panel di laptop yang sama. Generate token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Opsional: aktifkan log debug verbose (set 1)
# BRIDGE_DEBUG=1
