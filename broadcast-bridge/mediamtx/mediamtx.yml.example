# ============================================================
# MediaMTX — konfigurasi minimal untuk siaran STIKAR (PHASE 2)
# 1. Unduh MediaMTX gratis: https://github.com/bluenviron/mediamtx/releases
# 2. Salin file ini jadi mediamtx.yml di folder yang sama dengan binary.
# 3. Jalankan: ./mediamtx  (Windows: mediamtx.exe)
# 4. Stream masuk via WHIP  : http://127.0.0.1:8889/bof-main/whip
#    Pemutaran WebRTC (WHE): http://<ip-laptop>:8889/bof-main/whe
#    Fallback HLS          : http://<ip-laptop>:8888/bof-main/index.m3u8
# ============================================================
apiAddress: 127.0.0.1:9997
hlsAddress: :8888
hlsEncryption: false
webrtcAddress: :8889
webrtcAdditionalHosts: <IP-LAPTOP>   # contoh: 192.168.43.1 — IP hotspot laptop
paths:
  bof-main:
