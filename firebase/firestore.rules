rules_version = '2';

// ============================================================
// STIKAR ESPORTS — Battle Off Friends (BOF)
// Firestore Security Rules
// Publik: hanya BACA data yang sudah dipublikasikan.
// Admin: tulis sesuai peran di koleksi adminRoles.
// Superadmin: kelola peran admin & konfigurasi sistem.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() in ['admin', 'superadmin'];
    }

    // Staff turnamen: superadmin / admin / operator / judge / scoring
    // (Tournament Rules & Disciplinary Management).
    function isStaff() {
      return signedIn() && myRole() in ['superadmin', 'admin', 'operator', 'judge', 'scoring'];
    }

    function isSuperAdmin() {
      return signedIn() && myRole() == 'superadmin';
    }

    // ---------- adminRoles ----------
    // Hanya superadmin boleh mengelola peran; admin boleh MEMBACA sendiri.
    match /adminRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ---------- tournaments ----------
    match /tournaments/{tournamentId} {
      allow read: if resource.data.status == 'active' || resource.data.status == 'completed' || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      // ---------- teams ----------
      match /teams/{teamId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status in ['active', 'completed'];
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      // ---------- matches ----------
      match /matches/{matchId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status in ['active', 'completed'];

        allow create, update: if isAdmin();
        allow delete: if isSuperAdmin();

        // ---------- results (per match) ----------
        match /results/{teamId} {
          // Publik boleh membaca hasil match yang SUDAH dipublikasikan.
          allow read: if isAdmin()
            || get(/databases/$(database)/documents/tournaments/$(tournamentId))
                 .data.status in ['active', 'completed'];
          allow write: if isAdmin();
        }
      }
    }

    // ---------- publicLeaderboards ----------
    match /publicLeaderboards/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- scoringConfigurations ----------
    match /scoringConfigurations/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---------- broadcastSettings ----------
    match /broadcastSettings/{tournamentId} {
      allow read: if true;
      // Catatan: stream key TIDAK pernah disimpan di dokumen ini.
      allow write: if isAdmin();
    }

    // ---------- Heartbeat bridge lokal ----------
    // Ditulis oleh Broadcast Bridge di laptop produksi (Firebase Auth ANONYMOUS).
    // Isi: IP/port gateway, MediaMTX, OBS, jumlah penonton, updatedAt.
    // Dipakai admin dari perangkat mana pun untuk melihat bridge running/belum —
    // browser HTTPS tidak bisa men-probe http LAN langsung (mixed content).
    // TIDAK ada token/password di dokumen ini.
    match /bridgeHeartbeats/{tournamentId} {
      allow read: if isStaff();
      allow create, update: if request.auth != null
        && request.resource.data.tournamentId == tournamentId;
      allow delete: if false;
    }

    // ---------- observerEvents ----------
    // Publik hanya boleh membaca event yang DIKONFIRMASI panitia
    // dan bila fitur timeline publik diaktifkan.
    match /observerEvents/{tournamentId} {
      match /events/{eventId} {
        allow read: if isAdmin()
          || (resource.data.status == 'confirmed'
              && get(/databases/$(database)/documents/broadcastSettings/$(tournamentId)).data.showPublicTimeline == true);
        // Event ditulis oleh admin (konfirmasi/koreksi operator).
        allow create, update: if isAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ---------- auditLogs ----------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Log hanya dibuat oleh aplikasi admin terautentikasi; tidak bisa diedit/dihapus.
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- overlayConfigs ----------
    // Konfigurasi grafis siaran (Overlay Manager §13). OBS/TV Display
    // membaca konfigurasi ON AIR secara publik; hanya admin yang menulis.
    match /overlayConfigs/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- presentationState ----------
    // State layar TV (scene, playing, auto). TV membaca publik; admin tulis.
    match /presentationState/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- interactiveSettings ----------
    // Konfigurasi Interactive Game Stream (STIKAR Broadcast Agent, izin kontrol,
    // kualitas video). Website membaca publik; hanya admin yang mengubah.
    match /interactiveSettings/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- interactiveDevices ----------
    // Registrasi perangkat yang ter-pairing (HP operator/penonton, TV, laptop).
    // HANYA metadata perangkat — video dan input real-time TIDAK PERNAH
    // melewati Firestore (jalurnya WebRTC/WebSocket ke Agent di jaringan lokal).
    match /interactiveDevices/{deviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- interactiveSessions ----------
    // Metadata sesi kontrol: controller lock, grant/revoke izin operator,
    // waktu mulai/selesai. Juga hanya metadata.
    match /interactiveSessions/{sessionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Tournament Rules & Disciplinary Management ----------
    // Laporan pelanggaran: staff mencatat/mengubah status; delete hanya superadmin.
    match /disciplinaryViolations/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Sanksi: staff membuat/mengusulkan; penerapan & pembatalan divalidasi
    // di aplikasi (peran) DAN seluruh perubahan poin hanya lewat rebuild board.
    match /disciplinaryPenalties/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Status disiplin per tim (WARNING/SUSPENDED/BANNED/DISQUALIFIED/...).
    match /disciplinaryTeams/{teamId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Bukti pelanggaran: staff unggah/memperbarui metadata; hapus terkunci
    // setelah keputusan (ditegakkan juga di aplikasi).
    match /disciplinaryEvidence/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Keberatan (appeals).
    match /disciplinaryAppeals/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Audit log disiplin: create-only — TIDAK bisa diedit/dihapus admin mana pun.
    match /disciplinaryLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Konfigurasi penalti (ber-versi): baca staff, ubah superadmin.
    match /disciplinaryConfig/{id} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    // ---------- Default: tolak semua ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
