rules_version = '2';

// ============================================================
// STIKAR ESPORTS — Battle Off Friends (BOF)
// Firestore Security Rules
// Publik: hanya BACA data yang sudah dipublikasikan.
// Admin: tulis sesuai peran di koleksi adminRoles.
// Superadmin: kelola peran admin & konfigurasi sistem.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper ----------
    function signedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() in ['admin', 'superadmin'];
    }

    // Staff turnamen: superadmin / admin / operator / judge / scoring
    // (Tournament Rules & Disciplinary Management).
    function isStaff() {
      return signedIn() && myRole() in ['superadmin', 'admin', 'operator', 'judge', 'scoring'];
    }

    function isSuperAdmin() {
      return signedIn() && myRole() == 'superadmin';
    }

    // ---------- adminRoles ----------
    // Hanya superadmin boleh mengelola peran; admin boleh MEMBACA sendiri.
    match /adminRoles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ---------- tournaments ----------
    match /tournaments/{tournamentId} {
      allow read: if resource.data.status == 'active' || resource.data.status == 'completed' || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();

      // ---------- teams ----------
      match /teams/{teamId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status in ['active', 'completed'];
        allow create, update: if isAdmin();
        allow delete: if isAdmin();
      }

      // ---------- matches ----------
      match /matches/{matchId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.status in ['active', 'completed'];

        allow create, update: if isAdmin();
        allow delete: if isSuperAdmin();

        // ---------- results (per match) ----------
        match /results/{teamId} {
          // Publik boleh membaca hasil match yang SUDAH dipublikasikan.
          allow read: if isAdmin()
            || get(/databases/$(database)/documents/tournaments/$(tournamentId))
                 .data.status in ['active', 'completed'];
          allow write: if isAdmin();
        }
      }
    }

    // ---------- publicLeaderboards ----------
    match /publicLeaderboards/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- scoringConfigurations ----------
    match /scoringConfigurations/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---------- broadcastSettings ----------
    match /broadcastSettings/{tournamentId} {
      allow read: if true;
      // Catatan: stream key TIDAK pernah disimpan di dokumen ini.
      allow write: if isAdmin();
    }

    // ---------- Heartbeat bridge lokal ----------
    // Ditulis oleh Broadcast Bridge di laptop produksi (Firebase Auth ANONYMOUS).
    // Isi: IP/port gateway, MediaMTX, OBS, jumlah penonton, updatedAt.
    // Dipakai admin dari perangkat mana pun untuk melihat bridge running/belum —
    // browser HTTPS tidak bisa men-probe http LAN langsung (mixed content).
    // TIDAK ada token/password di dokumen ini.
    match /bridgeHeartbeats/{tournamentId} {
      allow read: if isStaff();
      allow create, update: if request.auth != null
        && request.resource.data.tournamentId == tournamentId;
      allow delete: if false;
    }

    // ---------- observerEvents ----------
    // Publik hanya boleh membaca event yang DIKONFIRMASI panitia
    // dan bila fitur timeline publik diaktifkan.
    match /observerEvents/{tournamentId} {
      match /events/{eventId} {
        allow read: if isAdmin()
          || (resource.data.status == 'confirmed'
              && get(/databases/$(database)/documents/broadcastSettings/$(tournamentId)).data.showPublicTimeline == true);
        // Event ditulis oleh admin (konfirmasi/koreksi operator).
        allow create, update: if isAdmin();
        allow delete: if isSuperAdmin();
      }
    }

    // ---------- auditLogs ----------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Log hanya dibuat oleh aplikasi admin terautentikasi; tidak bisa diedit/dihapus.
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- overlayConfigs ----------
    // Konfigurasi grafis siaran (Overlay Manager §13). OBS/TV Display
    // membaca konfigurasi ON AIR secara publik; hanya admin yang menulis.
    match /overlayConfigs/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- presentationState ----------
    // State layar TV (scene, playing, auto). TV membaca publik; admin tulis.
    match /presentationState/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- interactiveSettings ----------
    // Konfigurasi Interactive Game Stream (STIKAR Broadcast Agent, izin kontrol,
    // kualitas video). Website membaca publik; hanya admin yang mengubah.
    match /interactiveSettings/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- interactiveDevices ----------
    // Registrasi perangkat yang ter-pairing (HP operator/penonton, TV, laptop).
    // HANYA metadata perangkat — video dan input real-time TIDAK PERNAH
    // melewati Firestore (jalurnya WebRTC/WebSocket ke Agent di jaringan lokal).
    match /interactiveDevices/{deviceId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- interactiveSessions ----------
    // Metadata sesi kontrol: controller lock, grant/revoke izin operator,
    // waktu mulai/selesai. Juga hanya metadata.
    match /interactiveSessions/{sessionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Tournament Rules & Disciplinary Management ----------
    // Laporan pelanggaran: staff mencatat/mengubah status; delete hanya superadmin.
    match /disciplinaryViolations/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Sanksi: staff membuat/mengusulkan; penerapan & pembatalan divalidasi
    // di aplikasi (peran) DAN seluruh perubahan poin hanya lewat rebuild board.
    match /disciplinaryPenalties/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Status disiplin per tim (WARNING/SUSPENDED/BANNED/DISQUALIFIED/...).
    match /disciplinaryTeams/{teamId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Bukti pelanggaran: staff unggah/memperbarui metadata; hapus terkunci
    // setelah keputusan (ditegakkan juga di aplikasi).
    match /disciplinaryEvidence/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Keberatan (appeals).
    match /disciplinaryAppeals/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // Audit log disiplin: create-only — TIDAK bisa diedit/dihapus admin mana pun.
    match /disciplinaryLogs/{id} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Konfigurasi penalti (ber-versi): baca staff, ubah superadmin.
    match /disciplinaryConfig/{id} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isSuperAdmin();
    }

    // ---------- p2pSessions (signaling WebRTC mode P2P — PHASE 4) ----------
    // Video TIDAK PERNAH lewat Firestore — hanya tukar SDP/ICE (offer/answer/candidate).
    // Penonton ANONIM boleh membuat dokumen sesinya SENDIRI hanya bila panitia
    // benar-benar sedang siaran P2P (broadcastSettings.streamMode == 'p2p' && p2pLive == true),
    // dengan validasi ketat: field terbatas, state awal 'waiting', SDP ≤ 12000 karakter.
    // Menjawab/menolak/menghapus = HANYA admin. Tidak ada pelonggaran koleksi lain.
    match /p2pSessions/{tournamentId} {
      // Signaling hanya aktif saat siaran P2P sedang hidup (cegah spam saat fitur mati).
      function p2pBroadcasting() {
        return get(/databases/$(database)/documents/broadcastSettings/$(tournamentId)).data.streamMode == 'p2p'
          && get(/databases/$(database)/documents/broadcastSettings/$(tournamentId)).data.p2pLive == true;
      }

      match /viewers/{viewerId} {
        // get publik: penonton mendengarkan dokumennya sendiri (viewerId acak = kapasitasnya).
        // list HANYA admin (query koleksi viewers).
        allow get: if true;
        allow list: if isAdmin();
        // Create publik TIDAK bisa menulis field answer/reason (hasOnly) dan
        // TIDAK bisa memalsukan state/viewerId/createdAt (validated di bawah).
        allow create: if p2pBroadcasting()
          && request.resource.data.keys().hasOnly(['viewerId', 'createdAt', 'expiresAt', 'state', 'offer'])
          && request.resource.data.viewerId == viewerId
          && request.resource.data.state == 'waiting'
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.offer is map
          && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
          && request.resource.data.offer.type == 'offer'
          && request.resource.data.offer.sdp is string
          && request.resource.data.offer.sdp.size() > 0
          && request.resource.data.offer.sdp.size() <= 12000;
        // Jawaban (answer/state/reason) hanya admin — penonton tidak bisa mengubah.
        allow update: if isAdmin();
        allow delete: if isAdmin();

        match /candidates/{candidateId} {
          // Candidate dibaca publik (kedua sisi saling menukar ICE).
          allow read: if true;
          // Penonton anonim hanya boleh mengirim candidate MILIKNYA (from == 'viewer'),
          // ukuran wajar (≤ 2000 karakter), createdAt server-side.
          allow create: if p2pBroadcasting()
            && request.resource.data.keys().hasOnly(['from', 'candidate', 'createdAt'])
            && request.resource.data.from == 'viewer'
            && request.resource.data.candidate is string
            && request.resource.data.candidate.size() > 0
            && request.resource.data.candidate.size() <= 2000
            && request.resource.data.createdAt == request.time;
          // Candidate dari HOST ditulis admin.
          allow create: if isAdmin()
            && request.resource.data.from == 'host';
          allow update, delete: if isAdmin();
        }
      }
    }

    // ---------- livePresence (indikator penonton online — fitur Pengaya Siaran) ----------
    // Heartbeat anonim per tab penonton (TV /display, /live, halaman interaktif).
    // Isi HANYA: nama panggangan (maks 40 char) + timestamp. TIDAK ada data pribadi,
    // TIDAK ada token, TIDAK ada video. Dokumen lama dibersihkan penonton sendiri
    // saat menutup halaman; daftar "online" difilter klien (heartbeat ≤ 65 dtk).
    match /livePresence/{tournamentId} {
      match /viewers/{viewerId} {
        allow get, list: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['name', 'lastSeen', 'clientMs', 'sinceMs'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.clientMs is number
          && (!('sinceMs' in request.resource.data) || request.resource.data.sinceMs is number);
        // Tab menutup → penonton menghapus dokumennya sendiri (best-effort cleanup).
        allow delete: if true;
      }
    }

    // ---------- casterSessions (BOF CASTER — bagikan layar via kode pairing) ----------
    // Mirip hi.casts.app: dokumen id = KODE RAHASIA 6 digit. Kode adalah bagian
    // dari PATH → hanya pihak yang tahu kode yang bisa membaca sesi & menulis
    // signaling. Sesi dibuat/dimatikan HANYA admin (juga mencatat kode di
    // broadcastSettings.caster agar TV/penonton tahu), kedaluwarsa otomatis.
    // Penonton membuat offer; HOST anonim (laptop caster yang tahu kode)
    // menjawab answer + candidates. Batas ukuran SDP/candidate = anti-spam.
    match /casterSessions/{code} {
      function casterSessionActive() {
        return get(/databases/$(database)/documents/casterSessions/$(code)).data.active == true
          && get(/databases/$(database)/documents/casterSessions/$(code)).data.expiresAt is timestamp
          && request.time < get(/databases/$(database)/documents/casterSessions/$(code)).data.expiresAt;
      }

      // Kode = kunci: get publik (yang tahu kode, tahu alamat dokumennya),
      // list HANYA admin (mencegah enumerasi kode).
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /viewers/{viewerId} {
        // Jalur butuh kode rahasia → read publik aman.
        allow get, list: if true;
        // Penonton membuat sesinya sendiri: state 'waiting' + offer, divalidasi ketat.
        allow create: if casterSessionActive()
          && request.resource.data.keys().hasOnly(['viewerId', 'createdAt', 'expiresAt', 'state', 'offer'])
          && request.resource.data.viewerId == viewerId
          && request.resource.data.state == 'waiting'
          && request.resource.data.createdAt == request.time
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
          && request.resource.data.offer.type == 'offer'
          && request.resource.data.offer.sdp is string
          && request.resource.data.offer.sdp.size() > 0
          && request.resource.data.offer.sdp.size() <= 12000;
        // Host anonim (tahu kode) menjawab/menolak/membersihkan sesi —
        // hanya bila sesi masih aktif & belum kedaluwarsa.
        allow update, delete: if casterSessionActive();

        match /candidates/{candidateId} {
          allow read: if true;
          allow create: if casterSessionActive()
            && request.resource.data.keys().hasOnly(['from', 'candidate', 'createdAt'])
            && request.resource.data.from in ['viewer', 'host']
            && request.resource.data.candidate is string
            && request.resource.data.candidate.size() > 0
            && request.resource.data.candidate.size() <= 2000
            && request.resource.data.createdAt == request.time;
          allow update, delete: if casterSessionActive();
        }
      }
    }

    // ---------- ocrUploads (AI OCR — arsip screenshot + hasil analisa) ----------
    // Admin mengunggah screenshot hasil match (hosting: ImgBB/Supabase, link saja
    // yang disimpan), AI membaca placement/kill → formulir Entri Hasil terisi
    // otomatis. Arsip ini jejak audit: siapa mengunggah, kapan, hasil analisa.
    // Publik TIDAK boleh membaca; bukti yang dipakai publik tersalin ke dokumen
    // match (screenshotUrl) yang aturannya sudah ketat.
    match /ocrUploads/{uploadId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['tid', 'matchId', 'matchNumber', 'url', 'thumbUrl', 'deleteUrl', 'host', 'width', 'height', 'size', 'mime', 'filename', 'analysis', 'applied', 'createdAt'])
        && request.resource.data.tid is string
        && request.resource.data.matchId is string
        && request.resource.data.url is string
        && request.resource.data.url.matches('^https://.*')
        && request.resource.data.url.size() <= 600
        && request.resource.data.host in ['imgbb', 'supabase'];
      allow update, delete: if isAdmin();
    }

    // ---------- Default: tolak semua ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
