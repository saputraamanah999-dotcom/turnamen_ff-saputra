# ==============================================
# STIKAR ESPORTS — Battle Off Friends (BOF)
# CONTOH FILE ENV — salin jadi .env lalu isi
#   cp .env.example .env
# File .env TIDAK boleh di-commit!
# ==============================================

# ---- Firebase Web App (dari Project Settings > Your apps > SDK setup) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Service account (untuk seeding & deploy rules) ----
# Simpan file JSON service account di luar git, mis: ./secrets/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json

# ---- Akun super admin awal (dibuat oleh: npm run seed) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Identitas (opsional) ----
NEXT_PUBLIC_TOURNAMENT_NAME=BATTLE OFF FRIENDS
NEXT_PUBLIC_ORG_NAME=SMK TI BALI GLOBAL KARANGASEM
NEXT_PUBLIC_DEVELOPER=SAPUTRA DEVELOPER

# ---- AI OCR screenshot (fitur upload → isi formulir otomatis) ----
# ImgBB: hosting gambar screenshot (SATU-SATUNYA hosting — Supabase dihapus).
# Kosongkan → memakai key bawaan turnamen.
IMGBB_API_KEY=
# Jerexd Vision (GRATIS, rekomendasi utama): endpoint chatvision-v2
# menganalisa screenshot via LINK ImgBB. Key milik owner turnamen.
JERE_API_KEY=
JERE_MODEL=default
# Urutan mesin dipaksa (opsional): jere | gemini | openai | ocrspace. Kosong = auto.
AI_OCR_PROVIDER=auto
# Gemini Vision (alternatif gratis): ambil key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_OCR_MODEL=gemini-2.0-flash
# OpenAI-compatible (opsional — bisa dipakai utk endpoint Z.AI/GLM kompatibel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Fallback tanpa key: OCR.space ("helloworld" = key uji publik, hasil wajib dicek admin)
OCR_SPACE_KEY=helloworld
