# ==============================================
# STIKAR ESPORTS — Battle Off Friends (BOF)
# CONTOH FILE ENV — salin jadi .env lalu isi
#   cp .env.example .env
# File .env TIDAK boleh di-commit!
# ==============================================

# ---- Firebase Web App (dari Project Settings > Your apps > SDK setup) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- Service account (untuk seeding & deploy rules) ----
# Simpan file JSON service account di luar git, mis: ./secrets/serviceAccountKey.json
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json

# ---- Akun super admin awal (dibuat oleh: npm run seed) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Identitas (opsional) ----
NEXT_PUBLIC_TOURNAMENT_NAME=BATTLE OFF FRIENDS
NEXT_PUBLIC_ORG_NAME=SMK TI BALI GLOBAL KARANGASEM
NEXT_PUBLIC_DEVELOPER=SAPUTRA DEVELOPER

# ---- AI OCR screenshot (fitur upload → isi formulir otomatis) ----
# ImgBB: hosting gambar screenshot. Kosongkan → memakai key bawaan turnamen.
IMGBB_API_KEY=
# Gemini Vision (REKOMENDASI, gratis): ambil key di https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_OCR_MODEL=gemini-2.0-flash
# Alternatif OpenAI-compatible (opsional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Fallback tanpa key: OCR.space ("helloworld" = key uji publik, hasil wajib dicek admin)
OCR_SPACE_KEY=helloworld
# Supabase Storage sebagai cadangan hosting (bucket bof-screenshots dibuat otomatis)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
